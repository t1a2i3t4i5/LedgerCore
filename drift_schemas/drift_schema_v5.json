        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"member_id\" INTEGER NOT NULL REFERENCES members (id), \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"amount\" REAL NOT NULL CHECK((\"amount\" > 0.0 AND \"amount\" <= 999999999999.0) AND (amount = CAST(amount AS INTEGER))), \"spent_at\" INTEGER NOT NULL, \"memo\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
